#Вводим 2 числа для каждой двух клеток ( 1 по строке, 1 по столбцу)

line1, column1 = map(int, input("Введите два числа для строки и столбца 1-й клетки (1-8): ").split())
line2, column2 = map(int, input("Введите два числа для строки и столбца 2-й клетки (1-8): ").split())

#В cage_board1 и cage_board2 мы проверяем будет ли сумма чётной или нет, так как все белеые клетки на доске нечётный, а чёрный чётные

cage_board1 = (line1 + column1) % 2
cage_board2 = (line2 + column2) % 2

#Тут мы сравниваем cage_board1 и cage_board2 между друг другом, если они равны значит координаты двух заданых клеток находятся на одном цвете, если нет, то они
#находятся на разных цветах

if cage_board1 == cage_board2:
    print("YES")
else:
    print("NO")
